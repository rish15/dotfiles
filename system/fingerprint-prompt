#!/bin/sh
# Installed (root-owned) to /usr/local/bin/fingerprint-prompt and called by PAM
# (pam_exec) from /etc/pam.d/sudo:
#   fingerprint-prompt        -> show a centered "Touch the fingerprint sensor" popup
#   fingerprint-prompt done   -> close it (sudo authenticated)
# The popup is pinned to every workspace, doesn't take keyboard focus (so a
# password can still be typed in the terminal) and closes itself after 30s.
# pam_exec starts us with an almost empty environment
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
log=/tmp/fingerprint-prompt.log
echo "$(date '+%F %T') arg=${1:-show} ruser=$PAM_RUSER user=$PAM_USER svc=$PAM_SERVICE" >> "$log" 2>/dev/null

u="${PAM_RUSER:-${SUDO_USER:-$PAM_USER}}"
[ -n "$u" ] && [ "$u" != root ] || exit 0
uid=$(id -u "$u" 2>/dev/null) || exit 0
rt="/run/user/$uid"
pidf="$rt/fingerprint-prompt.pid"

close_popup() { [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null; rm -f "$pidf"; }

if [ "$1" = done ]; then
    close_popup
    exit 0
fi

wl=$(ls "$rt" 2>/dev/null | grep -m1 -E '^wayland-[0-9]+$') || { echo "  no wayland socket in $rt" >> "$log"; exit 0; }
command -v zenity >/dev/null || { echo "  zenity not installed" >> "$log"; exit 0; }
close_popup   # a previous attempt's popup (e.g. after a wrong password)

# During sudo's auth step pam_exec runs us as the invoking user (real UID), so
# only switch users when we really are root.
as_user=""
[ "$(id -u)" = 0 ] && as_user="runuser -u $u --"

$as_user env XDG_RUNTIME_DIR="$rt" WAYLAND_DISPLAY="$wl" GDK_BACKEND=wayland \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus" \
    setsid -f sh -c 'zenity --info --title="Authentication" --icon=auth-fingerprint \
        --text="<big><b>Touch the fingerprint sensor</b></big>\n\n$1 is asking for authentication.\nOr type your password in the terminal." \
        --ok-label="Hide" --width=380 --timeout=30 & echo $! > "$0"' "$pidf" "${PAM_SERVICE:-sudo}" \
    </dev/null >>"$log" 2>&1
echo "  popup launched on $wl for $u" >> "$log"
exit 0
