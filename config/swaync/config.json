{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 420,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": ["title", "buttons-grid", "volume", "backlight", "mpris", "dnd", "notifications"],
  "widget-config": {
    "title": {
      "text": "Control center",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": { "text": "Do not disturb" },
    "mpris": { "image-size": 72, "image-radius": 12 },
    "volume": { "label": "", "show-per-app": true },
    "backlight": { "label": "" },
    "buttons-grid": {
      "actions": [
        { "label": "", "tooltip": "Wi-Fi", "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'" },
        { "label": "", "tooltip": "Bluetooth", "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'" },
        { "label": "", "tooltip": "Night light", "command": "~/.config/hypr/scripts/nightlight.sh toggle" },
        { "label": "", "tooltip": "Screenshot region", "command": "sh -c 'swaync-client -cp; sleep 0.4; flameshot gui'" },
        { "label": "", "tooltip": "Clipboard", "command": "sh -c 'swaync-client -cp; cliphist list | rofi -dmenu | cliphist decode | wl-copy'" },
        { "label": "", "tooltip": "Lock", "command": "sh -c 'swaync-client -cp; hyprlock'" },
        { "label": "", "tooltip": "Audio mixer", "command": "sh -c 'swaync-client -cp; pavucontrol'" },
        { "label": "", "tooltip": "Power menu", "command": "sh -c 'swaync-client -cp; ~/.config/hypr/scripts/powermenu.sh'" }
      ]
    }
  }
}
